---
import type { Activity } from "@toddoo/types";
import { formatDate } from "../lib/activities";

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;

const categoryConfig: Record<string, { emoji: string; bg: string; border: string; shadow: string }> = {
  sports:    { emoji: "\u26BD", bg: "bg-green-50",   border: "border-green-300",  shadow: "shadow-[4px_4px_0px_0px_rgba(34,197,94,0.3)]" },
  arts:      { emoji: "\uD83C\uDFA8", bg: "bg-purple-50",  border: "border-purple-300", shadow: "shadow-[4px_4px_0px_0px_rgba(168,85,247,0.3)]" },
  music:     { emoji: "\uD83C\uDFB5", bg: "bg-pink-50",    border: "border-pink-300",   shadow: "shadow-[4px_4px_0px_0px_rgba(236,72,153,0.3)]" },
  outdoors:  { emoji: "\uD83C\uDF33", bg: "bg-emerald-50", border: "border-emerald-300", shadow: "shadow-[4px_4px_0px_0px_rgba(16,185,129,0.3)]" },
  camps:     { emoji: "\u26FA",  bg: "bg-amber-50",   border: "border-amber-300",  shadow: "shadow-[4px_4px_0px_0px_rgba(245,158,11,0.3)]" },
  library:   { emoji: "\uD83D\uDCDA", bg: "bg-blue-50",    border: "border-blue-300",   shadow: "shadow-[4px_4px_0px_0px_rgba(59,130,246,0.3)]" },
  community: { emoji: "\uD83C\uDF89", bg: "bg-orange-50",  border: "border-orange-300", shadow: "shadow-[4px_4px_0px_0px_rgba(249,115,22,0.3)]" },
  other:     { emoji: "\u2B50",  bg: "bg-gray-50",    border: "border-gray-300",   shadow: "shadow-[4px_4px_0px_0px_rgba(156,163,175,0.3)]" },
};

const config = categoryConfig[activity.category] || categoryConfig.other;
---

<a
  href={`/activity/${activity.slug}`}
  class:list={[
    "activity-card block rounded-2xl border-[2.5px] border-gray-900 p-5 transition-all duration-200",
    "hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]",
    "shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]",
    config.bg,
  ]}
  data-borough={activity.borough || ""}
  data-category={activity.category}
>
  <!-- Category emoji badge -->
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class:list={[
      "w-10 h-10 rounded-xl border-2 border-gray-900 flex items-center justify-center shrink-0 text-lg",
      config.bg,
    ]}>
      {config.emoji}
    </div>
    {activity.cost && (
      <span class="text-xs font-extrabold bg-white border-2 border-gray-900 rounded-full px-2.5 py-1 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        {activity.cost}
      </span>
    )}
  </div>

  <!-- Title -->
  <h3 class="font-extrabold text-lg leading-snug mb-1.5 text-gray-900">{activity.title}</h3>

  <!-- Description -->
  <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 mb-4">{activity.description}</p>

  <!-- Meta tags -->
  <div class="flex flex-wrap gap-1.5">
    <span class="inline-flex items-center gap-1 text-xs font-bold bg-white border-[1.5px] border-gray-300 rounded-lg px-2 py-1">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      {formatDate(activity.startDate)}
    </span>

    {activity.borough && (
      <span class="inline-flex items-center gap-1 text-xs font-bold bg-white border-[1.5px] border-gray-300 rounded-lg px-2 py-1">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {activity.borough}
      </span>
    )}

    {activity.recurrence && (
      <span class="inline-flex items-center gap-1 text-xs font-bold bg-[#FF6B2C] text-white border-[1.5px] border-gray-900 rounded-lg px-2 py-1">
        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        {activity.recurrence}
      </span>
    )}

    {activity.ageGroup && (
      <span class="inline-flex items-center text-xs font-bold bg-white border-[1.5px] border-gray-300 rounded-lg px-2 py-1">
        {activity.ageGroup === "all-ages" ? "All ages" : `Ages ${activity.ageGroup}`}
      </span>
    )}
  </div>
</a>
