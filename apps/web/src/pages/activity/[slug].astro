---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllSlugs, getActivityBySlug, formatDate } from "../../lib/activities";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const activity = getActivityBySlug(String(slug));

if (!activity) {
  return Astro.redirect("/404");
}

const categoryColors: Record<string, string> = {
  sports: "bg-green-100 text-green-800",
  arts: "bg-purple-100 text-purple-800",
  music: "bg-pink-100 text-pink-800",
  outdoors: "bg-emerald-100 text-emerald-800",
  camps: "bg-orange-100 text-orange-800",
  library: "bg-blue-100 text-blue-800",
  community: "bg-yellow-100 text-yellow-800",
  other: "bg-gray-100 text-gray-800",
};

const colorClass = categoryColors[activity.category] || categoryColors.other;
---

<BaseLayout title={activity.title} description={activity.description}>
  <div class="max-w-3xl mx-auto">
    <a href="/" class="text-indigo-600 hover:text-indigo-800 text-sm mb-4 inline-block">
      &larr; Back to all activities
    </a>

    <article class="bg-white rounded-lg border border-gray-200 p-6 sm:p-8">
      <div class="flex items-start justify-between gap-3 mb-4">
        <h1 class="text-2xl sm:text-3xl font-bold">{activity.title}</h1>
        <span class={`shrink-0 text-sm font-medium px-3 py-1 rounded-full ${colorClass}`}>
          {activity.category}
        </span>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 mb-6">
        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2 text-gray-600">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span>
              {formatDate(activity.startDate)}
              {activity.endDate && activity.endDate !== activity.startDate && ` - ${formatDate(activity.endDate)}`}
            </span>
          </div>

          {activity.recurrence && (
            <div class="flex items-center gap-2 text-gray-600">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>{activity.recurrence}</span>
            </div>
          )}

          {activity.ageGroup && (
            <div class="flex items-center gap-2 text-gray-600">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Ages: {activity.ageGroup}</span>
            </div>
          )}
        </div>

        <div class="space-y-2 text-sm">
          {activity.borough && (
            <div class="flex items-center gap-2 text-gray-600">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>{activity.borough}</span>
            </div>
          )}

          {activity.location && (
            <div class="flex items-center gap-2 text-gray-600">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span>{activity.location}</span>
            </div>
          )}

          {activity.address && (
            <div class="flex items-center gap-2 text-gray-600">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span>{activity.address}</span>
            </div>
          )}

          {activity.cost && (
            <div class="flex items-center gap-2 text-indigo-600 font-medium">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{activity.cost}</span>
            </div>
          )}
        </div>
      </div>

      <div class="prose prose-gray max-w-none mb-6">
        <p>{activity.description}</p>
      </div>

      <div class="flex items-center justify-between border-t border-gray-200 pt-4">
        <a
          href={activity.sourceUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-indigo-600 hover:text-indigo-800 text-sm font-medium"
        >
          View original
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <span class="text-xs text-gray-400">Source: {activity.source}</span>
      </div>
    </article>
  </div>
</BaseLayout>
